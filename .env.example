# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/play11?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-key-here-min-32-chars"

# SportMonk API Configuration
SPORTMONK_API_KEY="your-sportmonk-api-key-here"

# Payment Gateway (Razorpay) - Optional for development
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Email Service Configuration - Optional
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# AWS S3 Configuration - Optional for file uploads
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
S3_BUCKET_NAME=""

# Node Environment
NODE_ENV="development"